# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3001
#   Authorization callback URL: http://localhost:3001/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie that holds your GitHub token.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional: the public URL of the app when it isn't http://localhost:3001
# APP_URL=https://pr-radar.example.com
